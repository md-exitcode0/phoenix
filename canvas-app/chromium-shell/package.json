{
  "name": "phoenix-chromium-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium-composited desktop shell and embedded browser surface for Phoenix",
  "main": "main.cjs",
  "scripts": {
    "build:liquid-menu": "node build-liquid-menu.mjs",
    "build:terminal": "esbuild terminal-entry.mjs --bundle --minify --format=iife --platform=browser --target=chrome120,safari17 --outfile=../ui/terminal-bundle.js",
    "start": "electron .",
    "selftest": "PHOENIX_CHROMIUM_SELFTEST=1 electron .",
    "integration-check": "node integration-check.mjs"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "esbuild": "^0.25.9",
    "liquid-gooey": "^0.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ws": "8.18.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "file:./safe-adm-zip",
    "electron-chrome-web-store": "^0.13.0"
  },
  "overrides": {
    "adm-zip": "$adm-zip"
  }
}
